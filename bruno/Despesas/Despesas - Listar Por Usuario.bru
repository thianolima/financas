meta {
  name: Despesas - Listar Por Usuario
  type: http
  seq: 3
}

get {
  url: {{URL_SERVER}}/despesas?anomes=202608&pagina=1&tamanho=50
  body: none
  auth: bearer
}

params:query {
  anomes: 202608
  pagina: 1
  tamanho: 50
  ~cartao: {{CARTAO_VISA}}
  ~tipo: RECORRENTE
  ~categoria: 16
}

auth:bearer {
  token: {{TOKEN}}
}

settings {
  encodeUrl: true
  timeout: 0
}

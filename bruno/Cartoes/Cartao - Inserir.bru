meta {
  name: Cartao - Inserir
  type: http
  seq: 5
}

post {
  url: {{URL_SERVER}}/cartoes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{TOKEN}}
}

body:json {
    {
      "nome": "CARTAO TESTE",
      "bandeira": "MASTER",
      "diaVencimento": 15,
      "numeroFinal": "1234",
      "titular":"THIANO LIMA",
      "valorLimite": 10000,
      "cor":"BLUE",
      "cartaoAdicional":false
    }
}

settings {
  encodeUrl: true
  timeout: 0
}

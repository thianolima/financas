meta {
  name: Cartao - Upload da Fatura VISA
  type: http
  seq: 5
}

post {
  url: {{URL_SERVER}}/cartao/{{CARTAO_VISA}}/fatura/upload
  body: json
  auth: bearer
}

auth:bearer {
  token: {{TOKEN}}
}

body:json {
  {
    "anoMes": "{{ANO_MES}}",
    "nomeArquivo": "{{NOME_ARQUIVO_XLSX}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
